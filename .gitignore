# Build output. Everything here is regenerated by `dotnet build`, and bin/
# carries Avalonia's native payload for every RID - well over 100 MB.
bin/
obj/

# dotnet publish staging for the AppImage (self-contained, ~100 MB).
publish/

# AppImage packaging artefacts (regenerated by ./install-appimage.sh).
*.AppImage
appimagetool
.*-appdir/
squashfs-root/

# Editor / OS noise
.vs/
.idea/
*.user
*.swp
.DS_Store
